# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Gestion des Examens Universitaires - Frontend
# ============================================

# API Backend URL (à remplacer après déploiement du backend)
REACT_APP_API_URL=https://gestion-examens-backend.onrender.com/api

# Build Configuration
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true
CI=false

# Application Configuration
REACT_APP_APP_NAME=UniExam - Gestion des Examens
REACT_APP_VERSION=2.0.0

# Feature Flags
REACT_APP_ENABLE_PDF_EXPORT=true
REACT_APP_ENABLE_EXCEL_EXPORT=true

# Session Configuration
REACT_APP_SESSION_TIMEOUT=120

# Pagination
REACT_APP_ITEMS_PER_PAGE=10

# Debug
REACT_APP_DEBUG=false
